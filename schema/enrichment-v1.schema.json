{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hippo.invalid/schema/enrichment-v1.schema.json",
  "title": "Hippo enrichment (enrichment.json), schema version 1",
  "description": "Derived data for one capture and one layer (device = silver, server = gold). Unknown additional properties must be ignored by readers. Unavailable optional fields are omitted, never null.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "capture_id", "layer", "package_digest", "producer", "generated_at", "facets"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_minor": { "type": "integer", "minimum": 0 },
    "capture_id": { "$ref": "#/$defs/uuid" },
    "layer": { "enum": ["device", "server"] },
    "package_digest": { "$ref": "#/$defs/sha256", "description": "SHA-256 of the exact bytes of the capture's complete.json that this was derived from." },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version", "build"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "build": { "type": "string" }
      }
    },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "facets": {
      "type": "object",
      "description": "Keyed by facet kind (open set). Unknown kinds allow any data.",
      "additionalProperties": { "$ref": "#/$defs/facet" },
      "propertyNames": { "minLength": 1 }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "description": "RFC 3339 UTC, e.g. 2026-11-07T18:00:00.000Z." },
    "assetRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relative_path", "byte_count", "sha256"],
      "properties": {
        "relative_path": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]{1,10}$" },
        "byte_count": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mime_type": { "type": "string" }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "status", "generated_at", "provenance"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "minLength": 1, "examples": ["ok", "empty", "failed"], "description": "Open set." },
        "generated_at": { "$ref": "#/$defs/timestamp" },
        "provenance": { "type": "string", "minLength": 1, "description": "Open set." },
        "data": { "description": "Payload; shape depends on the facet kind. Omitted for empty/failed facets." }
      }
    },
    "linkPreviewData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["url"], "additionalProperties": true,
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "site_name": { "type": "string" },
          "channel": { "type": "string" },
          "description": { "type": "string" },
          "canonical_url": { "type": "string" },
          "thumbnail": { "$ref": "#/$defs/assetRef" }
        } } } }
    },
    "placeData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["target"], "additionalProperties": true,
        "properties": {
          "target": { "type": "string", "description": "\"capture\" or an attachment ID." },
          "sub_locality": { "type": "string" },
          "locality": { "type": "string" },
          "region": { "type": "string" },
          "country": { "type": "string" },
          "nearby": {
            "type": "object", "required": ["name", "distance_meters"], "additionalProperties": true,
            "properties": { "name": { "type": "string" }, "distance_meters": { "type": "number", "minimum": 0 } }
          }
        } } } }
    },
    "textRecognitionData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "text", "languages"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid" },
          "text": { "type": "string" },
          "languages": { "type": "array", "items": { "type": "string" } }
        } } } }
    },
    "transcriptData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "text", "locale", "segments"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid" },
          "text": { "type": "string" },
          "locale": { "type": "string" },
          "segments": { "type": "array", "items": {
            "type": "object", "required": ["start", "end", "text"], "additionalProperties": true,
            "properties": { "start": { "type": "number" }, "end": { "type": "number" }, "text": { "type": "string" } }
          } }
        } } } }
    },
    "dataDetectionData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["type", "text", "source"], "additionalProperties": true,
        "properties": {
          "type": { "type": "string", "examples": ["date", "phone", "address", "link"] },
          "text": { "type": "string" },
          "value": { "type": "string" },
          "components": { "type": "object", "additionalProperties": { "type": "string" } },
          "source": { "type": "string" }
        } } } }
    },
    "sourceAppGuessData": {
      "type": "object", "required": ["app", "reason"], "additionalProperties": true,
      "properties": { "app": { "type": "string" }, "reason": { "type": "string" } }
    },
    "summaryData": {
      "type": "object", "required": ["text"], "additionalProperties": true,
      "properties": { "text": { "type": "string" } }
    },
    "tagsData": {
      "type": "object", "required": ["values"], "additionalProperties": true,
      "properties": { "values": { "type": "array", "items": { "type": "string" } } }
    },
    "motionSample": {
      "type": "object", "required": ["started_at", "activities", "confidence"], "additionalProperties": true,
      "properties": {
        "started_at": { "$ref": "#/$defs/timestamp" },
        "activities": { "type": "array", "items": { "type": "string" }, "description": "Open set: stationary, walking, running, cycling, automotive, unknown." },
        "confidence": { "type": "string", "description": "Open set: low, medium, high." }
      }
    },
    "motionActivityData": {
      "type": "object", "required": ["window_start", "window_end", "segments"], "additionalProperties": true,
      "properties": {
        "window_start": { "$ref": "#/$defs/timestamp" },
        "window_end": { "$ref": "#/$defs/timestamp" },
        "at_capture": { "$ref": "#/$defs/motionSample" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/motionSample" } }
      }
    },
    "weatherData": {
      "type": "object", "required": ["observed_hour", "source", "requested_latitude", "requested_longitude"],
      "additionalProperties": true,
      "properties": {
        "observed_hour": { "$ref": "#/$defs/timestamp" },
        "temperature_celsius": { "type": "number" },
        "apparent_temperature_celsius": { "type": "number" },
        "relative_humidity_percent": { "type": "number" },
        "precipitation_millimeters": { "type": "number" },
        "cloud_cover_percent": { "type": "number" },
        "wind_speed_meters_per_second": { "type": "number" },
        "weather_code": { "type": "integer", "description": "WMO code." },
        "condition": { "type": "string", "description": "Open set: clear, partly_cloudy, cloudy, fog, drizzle, rain, freezing_rain, snow, showers, thunderstorm." },
        "is_day": { "type": "boolean" },
        "source": { "type": "string" },
        "requested_latitude": { "type": "number" },
        "requested_longitude": { "type": "number" }
      }
    },
    "barcodesData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "symbology", "payload"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid" },
          "symbology": { "type": "string", "description": "Lowercase; open set (qr, ean13, code128, ...)." },
          "payload": { "type": "string", "maxLength": 2048 },
          "url": { "type": "string" }
        } } } }
    },
    "languageData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["source", "language", "confidence"], "additionalProperties": true,
        "properties": {
          "source": { "type": "string", "description": "Open set: user_note, shared_text, note_body." },
          "language": { "type": "string", "description": "BCP 47 tag." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        } } } }
    },
    "soundClassificationData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "labels"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid", "description": "The comment_id for a comment's audio." },
          "labels": { "type": "array", "items": {
            "type": "object", "required": ["label", "confidence"], "additionalProperties": true,
            "properties": {
              "label": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            } } }
        } } } }
    },
    "screenshotData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "reason"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid" },
          "reason": { "type": "string", "description": "Open set: exif_user_comment, screen_size_match." }
        } } } }
    },
    "displayData": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "topic": { "type": "string", "minLength": 1 },
        "keywords": { "type": "array", "maxItems": 12, "items": {
          "type": "object", "required": ["word", "weight"], "additionalProperties": true,
          "properties": {
            "word": { "type": "string", "minLength": 1 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          } } }
      }
    },
    "imageDescriptionData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["attachment_id", "text"], "additionalProperties": true,
        "properties": {
          "attachment_id": { "$ref": "#/$defs/uuid" },
          "text": { "type": "string" }
        } } } }
    },
    "peopleData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["name", "source"], "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1, "description": "Open set: user_note, shared_text, shared_title, an attachment ID or a comment ID." }
        } } } }
    },
    "circumstanceData": {
      "type": "object", "required": ["items"], "additionalProperties": true,
      "properties": { "items": { "type": "array", "items": {
        "type": "object", "required": ["label", "confidence"], "additionalProperties": true,
        "properties": {
          "label": { "type": "string", "minLength": 1, "description": "Open set: in_car, walking, running, cycling, on_headphones, in_a_burst, daylight, dark." },
          "confidence": { "type": "string", "minLength": 1, "description": "Open set: low, medium, high." },
          "evidence": { "type": "array", "items": { "type": "string" } }
        } } } }
    }
  },
  "allOf": [
    {
      "properties": {
        "facets": {
          "properties": {
            "link_preview": { "properties": { "data": { "$ref": "#/$defs/linkPreviewData" } } },
            "place": { "properties": { "data": { "$ref": "#/$defs/placeData" } } },
            "text_recognition": { "properties": { "data": { "$ref": "#/$defs/textRecognitionData" } } },
            "transcript": { "properties": { "data": { "$ref": "#/$defs/transcriptData" } } },
            "data_detection": { "properties": { "data": { "$ref": "#/$defs/dataDetectionData" } } },
            "source_app_guess": { "properties": { "data": { "$ref": "#/$defs/sourceAppGuessData" } } },
            "summary": { "properties": { "data": { "$ref": "#/$defs/summaryData" } } },
            "tags": { "properties": { "data": { "$ref": "#/$defs/tagsData" } } },
            "motion_activity": { "properties": { "data": { "$ref": "#/$defs/motionActivityData" } } },
            "weather": { "properties": { "data": { "$ref": "#/$defs/weatherData" } } },
            "barcodes": { "properties": { "data": { "$ref": "#/$defs/barcodesData" } } },
            "language": { "properties": { "data": { "$ref": "#/$defs/languageData" } } },
            "sound_classification": { "properties": { "data": { "$ref": "#/$defs/soundClassificationData" } } },
            "screenshot": { "properties": { "data": { "$ref": "#/$defs/screenshotData" } } },
            "display": { "properties": { "data": { "$ref": "#/$defs/displayData" } } },
            "image_description": { "properties": { "data": { "$ref": "#/$defs/imageDescriptionData" } } },
            "people": { "properties": { "data": { "$ref": "#/$defs/peopleData" } } },
            "circumstance": { "properties": { "data": { "$ref": "#/$defs/circumstanceData" } } }
          }
        }
      }
    }
  ]
}
