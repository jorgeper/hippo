{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hippo.invalid/schema/complete-v1.schema.json",
  "title": "Hippo completion marker (complete.json), schema version 1",
  "description": "Written last. Lists every file in the package except itself. Unknown additional properties must be ignored.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "capture_id", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_minor": { "type": "integer", "minimum": 0 },
    "capture_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["relative_path", "byte_count", "sha256"],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^(metadata\\.json|content/[0-9a-f-]{36}\\.[a-z0-9]{1,10})$"
          },
          "byte_count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
